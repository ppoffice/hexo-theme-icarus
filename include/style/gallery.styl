// Justified Gallery 4 uses .jg-caption; retain the theme's hover captions.
.justified-gallery > a:hover > .jg-caption
    display: initial
    opacity: .7

// Vendor CSS loads after the theme; keep caption overrides specific to the dialog.
body .lg-container
    .lg-sub-html
        // The lightbox stays dark regardless of the page's appearance or variant.
        color: #fff
        background: transparent
        text-shadow: 0 1px 3px rgba(0, 0, 0, .8)
        font-family: $family-sans-serif
        border-radius: 0

        overflow-wrap: anywhere

    .lg-icon:focus-visible
        outline: 3px solid $link
        outline-offset: 3px

@media (prefers-reduced-motion: reduce)
    .lg-container .lg-item
        animation-duration: .01ms !important
        transition-duration: .01ms !important
