/* ---------------------------------
 *           Top Navigation
 * --------------------------------- */
$navbar-item-padding-v ?= 1.25rem
$navbar-item-padding-h ?= .75rem
$navbar-item-margin-v ?= 0
$navbar-item-margin-h ?= 0

.navbar-main
    box-shadow: $shadow

    .navbar-container
        overflow-x: auto

    .navbar-menu, .navbar-start, .navbar-end
        align-items: stretch
        display: flex
        padding: 0
        flex-shrink: 0

    .navbar-menu
        flex-grow: 1
        flex-shrink: 0
        overflow-x: auto

    .navbar-start
        justify-content: flex-start
        margin-right: auto

    .navbar-end
        justify-content: flex-end
        margin-left: auto

    .navbar-item
        display: flex
        align-items: center
        padding: $navbar-item-padding-v $navbar-item-padding-h
        margin: $navbar-item-margin-v $navbar-item-margin-h

        &.is-active
            background-color: transparent

    // Icon buttons (table of contents, search) look and behave like the navbar links
    button.navbar-item
        border: none
        background: none
        font: inherit
        color: $navbar-item-color
        cursor: pointer

        &:focus, &:hover
            background-color: $navbar-item-hover-background-color
            color: $navbar-item-hover-color

    // source/js/main.js folds the menu links into a drop-down below the other navbar items
    // when they do not fit on one line. Without JavaScript, the menu scrolls horizontally.
    .navbar-toggle
        display: none

        &[aria-expanded="true"]
            color: $navbar-item-active-color

    &.is-collapsed
        .navbar-menu
            flex-wrap: wrap
            flex-shrink: 1
            min-width: 0

        .navbar-toggle
            display: flex

        .navbar-start
            display: none
            order: 1
            flex-basis: 100%
            flex-direction: column
            align-items: center
            margin: 0
            padding-bottom: .5rem

            .navbar-item
                margin: 0
                padding: .5rem $navbar-item-padding-h

    &.is-collapsed.is-open .navbar-start
        display: flex

    // Sub-menus: a button (.navbar-link) followed by its links (.navbar-dropdown). Without
    // JavaScript, the links show next to the button while it is hovered or focused, in the
    // horizontally scrolling menu. source/js/main.js (.is-scripted) opens them with the button,
    // as a drop-down below it, or under it in the folded menu.
    .navbar-item.has-dropdown
        align-items: stretch
        margin: 0
        padding: 0

    .navbar-link
        display: flex
        align-items: center
        margin: $navbar-item-margin-v $navbar-item-margin-h
        padding: $navbar-item-padding-v 2.25em $navbar-item-padding-v $navbar-item-padding-h
        border: none
        background: none
        font: inherit
        line-height: 1.5
        color: $navbar-item-color
        cursor: pointer

        &::after
            display: block
            border-color: currentColor
            right: 1em

        &[aria-expanded="true"]::after
            margin-top: -.125em
            transform: rotate(135deg)

        &:focus, &:hover
            background-color: $navbar-item-hover-background-color
            color: $navbar-item-hover-color

        &.is-active
            color: $navbar-item-active-color

    .navbar-dropdown
        display: none
        position: static
        min-width: 0
        padding: 0
        background: none
        border: none
        box-shadow: none

        a.navbar-item
            &:focus, &:hover
                background-color: $navbar-item-hover-background-color
                color: $navbar-item-hover-color

            &.is-active
                background-color: transparent
                color: $navbar-item-active-color

    &:not(.is-scripted) .navbar-item.has-dropdown
        &:hover, &:focus-within
            .navbar-dropdown
                display: flex

    &.is-scripted
        // The menu is fitted with its drop-downs closed, so that opening one cannot fold it.
        &.is-measuring .navbar-dropdown
            display: none !important

        // Do not clip the drop-downs: the menu only scrolls if it still does not fit once folded.
        &:not(.is-scrolling)
            .navbar-container, .navbar-menu
                overflow: visible

    &.is-scripted:not(.is-collapsed)
        .navbar-dropdown
            position: absolute
            top: 100%
            left: 0
            z-index: $navbar-dropdown-z
            min-width: 100%
            width: max-content
            max-width: calc(100vw - 2rem)
            padding: .5rem 0
            font-size: .875rem
            background-color: $navbar-background-color
            border-top: $navbar-dropdown-border-top
            border-radius: 0 0 $navbar-dropdown-radius $navbar-dropdown-radius
            box-shadow: 0 8px 8px rgba($scheme-invert, .1)

            .navbar-item
                margin: 0
                padding: .375rem 1rem
                white-space: normal
                overflow-wrap: anywhere

        .navbar-link[aria-expanded="true"] + .navbar-dropdown
            display: block

        // Above the sticky columns (z-index: 99) while a drop-down is open, under the overlays.
        &.is-dropdown-open
            z-index: 100

        @media (hover: hover) and (pointer: fine)
            &:hover
                z-index: 100

            .navbar-item.has-dropdown:not(.is-hover-closed):hover .navbar-dropdown
                display: block

    &.is-collapsed .navbar-start
        .navbar-item.has-dropdown
            flex-direction: column
            align-items: center
            padding: 0

        .navbar-link
            margin: 0
            padding: .5rem 2.25em

        .navbar-link[aria-expanded="true"] + .navbar-dropdown
            display: flex
            flex-direction: column
            align-items: center
            padding-bottom: .25rem
            font-size: .875rem

            .navbar-item
                padding: .375rem $navbar-item-padding-h

    +from($navbar-breakpoint)
        &.is-collapsed
            .navbar-brand
                align-self: flex-start

            .navbar-toggle
                margin-left: auto

            .navbar-end
                margin-left: 0

    +until($navbar-breakpoint)
        .navbar-menu
            justify-content: center
            box-shadow: none

        .navbar-start
            margin-right: 0

        .navbar-end
            margin-left: 0

.navbar-logo
    img
        max-height: $logo-height

@media screen and (min-width: $desktop)
    .navbar > .container .navbar-menu, .container > .navbar .navbar-menu
        margin-right: 0rem
