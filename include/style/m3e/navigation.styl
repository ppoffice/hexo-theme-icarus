// 3. Navigation

html .navbar-main
    background-color: var(--m3-surface)
    box-shadow: none

    .navbar-container, .navbar-menu, .navbar-brand
        background-color: transparent
        box-shadow: none

    &[data-sticky]
        background-color: unquote('color-mix(in oklab, var(--m3-surface) 88%, transparent)')
        -webkit-backdrop-filter: unquote('saturate(1.4) blur(14px)')
        backdrop-filter: unquote('saturate(1.4) blur(14px)')

    .navbar-start .navbar-item, .navbar-item.has-dropdown .navbar-link
        margin: .7rem 2px
        padding: .55rem 1.05rem
        border-radius: var(--m3-r-m)
        color: var(--m3-on-surface-variant)
        font-weight: 500
        letter-spacing: .01em
        transition: var(--m3-state-transition)

    .navbar-start .navbar-item.has-dropdown
        margin: 0
        padding: 0
        background: none

    .navbar-start a.navbar-item:hover, .navbar-start a.navbar-item:focus, .navbar-item.has-dropdown .navbar-link:hover
        m3e-hover-surface()

    .navbar-start > a.navbar-item.is-active, .navbar-start > a.navbar-item.is-active:not(:focus):not(:hover), .navbar-item.has-dropdown .navbar-link.is-active
        m3e-secondary-surface()
        font-weight: 700

    .navbar-brand
        margin-left: 0

    .navbar-logo
        padding-left: 1.6rem
        padding-right: 1rem

    .navbar-end .navbar-item, button.navbar-item
        color: var(--m3-on-surface-variant)
        background: none

    .navbar-end .navbar-item
        width: 44px
        height: 44px
        margin: auto 2px
        padding: 0
        justify-content: center
        border-radius: var(--m3-r-m)
        transition: var(--m3-state-transition)

    .navbar-end .navbar-item:hover, button.navbar-item:hover, button.navbar-item:focus
        m3e-hover-surface()

    .navbar-toggle
        border-radius: var(--m3-r-m)
        transition: var(--m3-state-transition)

// Keep comma-bearing :is() selectors at root: Stylus otherwise repeats the
// nested parent inside the pseudo-class's selector list.
// Bounded radii and a non-overshooting easing keep press/release from snapping through zero.
html .navbar-main .navbar-start > a.navbar-item:is(:hover, :focus-visible)
    border-radius: 24px

html .navbar-main .navbar-link:is(:hover, :focus-visible)
    border-radius: 24px

html .navbar-main .navbar-end .navbar-item:is(:hover, :focus-visible)
    border-radius: 24px

html .navbar-main .navbar-toggle:is(:hover, :focus-visible)
    border-radius: 24px

html .navbar-main
    .navbar-toggle[aria-expanded="true"]
        m3e-secondary-surface()

    &.is-collapsed .navbar-dropdown
        background: var(--m3-navbar)
        border-radius: var(--m3-r-l)

    &.is-scripted:not(.is-collapsed) .navbar-dropdown
        background-color: var(--m3-navbar)
        border: none
        border-radius: var(--m3-r-l)
        box-shadow: var(--m3-elev-3)
        padding: .5rem
        transform-origin: top left
        animation: m3-menu var(--m3-spring-fast-ms) var(--m3-spring-fast)

    .navbar-dropdown .navbar-item, &.is-scripted:not(.is-collapsed) .navbar-dropdown .navbar-item
        margin: 1px 0
        padding: .6rem 1rem
        border-radius: var(--m3-r-m)
        color: var(--m3-on-surface)
        transition: var(--m3-state-transition)

    &.is-scripted:not(.is-collapsed) .navbar-dropdown a.navbar-item:hover
        border-radius: 20px
        background-color: var(--m3-surface-container-highest)
        color: var(--m3-on-surface)

    .navbar-dropdown a.navbar-item.is-active, &.is-scripted:not(.is-collapsed) .navbar-dropdown a.navbar-item.is-active
        m3e-secondary-surface()
        font-weight: 600

    &.is-collapsed .navbar-start .navbar-item
        margin: 2px 0

    &.is-collapsed .navbar-start .navbar-link[aria-expanded="true"] + .navbar-dropdown a.navbar-item
        color: var(--m3-on-surface-variant)
