// 15. Archive cards

html .column-main > .card:has(.timeline)
    position: relative
    isolation: isolate
    overflow: hidden

    &::after
        content: ""
        position: absolute
        right: -50px
        top: -60px
        width: 200px
        height: 200px
        z-index: -1
        opacity: .7
        background: var(--acc-c)
        m3e-mask(var(--m3-shape-cookie9))
        transition: transform var(--m3-spring-slow-ms) var(--m3-spring-slow)

    &:hover::after
        transform: rotate(40deg) scale(1.06)

    .card-content
        padding: 1.75rem 2rem 1.5rem

html .card .card-content > h3.tag.is-primary
    display: block
    height: auto
    padding: 0
    margin: 0 0 .5rem
    background: none
    border-radius: 0
    color: var(--acc)
    font: 900 4.5rem/1 var(--m3-font)
    letter-spacing: -.02em
    font-variant-numeric: tabular-nums

html .timeline
    position: relative
    border-left: none
    margin-left: .5rem
    padding: .75rem 0 0 1.5rem

    &::before
        content: ""
        position: absolute
        left: 0
        top: 1.25rem
        bottom: 0
        width: 2px
        border-radius: 1px
        background: var(--acc-c, var(--m3-outline-variant))

    .media
        margin: 2px 0 0
        padding: .65rem .85rem
        align-items: center

        & + .media
            border: none
            margin-top: 2px
            padding-top: .65rem

        &:hover
            background-color: unquote('color-mix(in oklab, var(--acc-c, var(--m3-surface-container-high)) 55%, transparent)')

        &::before, &:first-child::before
            z-index: 1
            left: calc(1px - 1.5rem - 8px) !important
            top: 50% !important
            width: 16px !important
            height: 16px !important
            margin-top: -8px
            background: var(--acc, var(--m3-primary)) !important

        &:hover::before
            transform: rotate(60deg) scale(1.35)

        // The tail eraser must stay behind the flower, even when the flower scales on hover.
        &:last-child::after, &:first-child:last-child::after
            z-index: 0
            left: calc(1px - 1.5rem - 8px)
            width: 16px
            top: calc(50% + 8px)
            bottom: 0
            background: var(--m3-card)

        .media-left
            margin-right: 1rem

        .media-left .image
            width: 64px
            height: 64px
            border-radius: var(--m3-r-l)
            overflow: hidden

        .media-left .image img
            width: 100%
            height: 100%
            object-fit: cover

        .date
            color: var(--acc, var(--m3-primary))
            font-family: var(--m3-font-mono)
            font-weight: 500

        .title
            margin: .15rem 0 0

        .title a
            color: var(--m3-on-surface)
            font-family: var(--m3-font)
            font-weight: 650
            font-size: 1.08rem
            line-height: 1.45

        .title a:hover
            color: var(--acc, var(--m3-primary))

        .categories
            text-transform: none !important
            margin-top: .35rem
            display: flex
            flex-wrap: wrap
            gap: 4px
            align-items: center

        .categories a
            display: inline-flex
            align-items: center
            height: 24px
            padding: 0 10px
            border-radius: var(--m3-r-s)
            background: var(--acc-c, var(--m3-secondary-container))
            color: var(--acc-on-c, var(--m3-on-secondary-container))
            font-weight: 600
            transition: var(--m3-state-transition)

        .categories a:hover
            border-radius: 12px
