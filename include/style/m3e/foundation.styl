// Icarus · Material 3 Expressive. Change --m3-h to change the seed hue.

// 1. Tokens

:root
    --m3-h: 285
    --m3-card-r: 28px
    --m3-state-transition: background-color 180ms ease, color 180ms ease, border-radius 240ms cubic-bezier(.2, 0, 0, 1)
    --m3-primary: oklch(0.50 0.17 var(--m3-h))
    --m3-on-primary: oklch(0.99 0.01 var(--m3-h))
    --m3-primary-container: oklch(0.90 0.08 var(--m3-h))
    --m3-on-primary-container: oklch(0.30 0.12 var(--m3-h))
    --m3-secondary: oklch(0.52 0.06 var(--m3-h))
    --m3-on-secondary: oklch(0.99 0.01 var(--m3-h))
    --m3-secondary-container: oklch(0.91 0.04 var(--m3-h))
    --m3-on-secondary-container: oklch(0.30 0.05 var(--m3-h))
    --m3-tertiary: oklch(0.55 0.14 calc(var(--m3-h) + 75))
    --m3-on-tertiary: oklch(0.99 0.01 calc(var(--m3-h) + 75))
    --m3-tertiary-container: oklch(0.90 0.09 calc(var(--m3-h) + 75))
    --m3-on-tertiary-container: oklch(0.32 0.10 calc(var(--m3-h) + 75))
    --m3-warning-container: oklch(0.92 0.09 85)
    --m3-on-warning-container: oklch(0.36 0.08 70)
    --m3-error-container: oklch(0.92 0.06 25)
    --m3-on-error-container: oklch(0.38 0.14 25)
    --m3-surface: oklch(0.975 0.01 var(--m3-h))
    --m3-surface-container-lowest: oklch(1 0 0)
    --m3-surface-container-low: oklch(0.99 0.006 var(--m3-h))
    --m3-surface-container: oklch(0.95 0.015 var(--m3-h))
    --m3-surface-container-high: oklch(0.93 0.017 var(--m3-h))
    --m3-surface-container-highest: oklch(0.91 0.02 var(--m3-h))
    --m3-on-surface: oklch(0.22 0.02 var(--m3-h))
    --m3-on-surface-variant: oklch(0.42 0.025 var(--m3-h))
    --m3-outline: oklch(0.62 0.025 var(--m3-h))
    --m3-outline-variant: oklch(0.86 0.02 var(--m3-h))
    --m3-inverse-surface: oklch(0.30 0.02 var(--m3-h))
    --m3-inverse-on-surface: oklch(0.95 0.01 var(--m3-h))
