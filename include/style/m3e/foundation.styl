    --m3-surface-container-lowest: oklch(0.13 0.01 var(--m3-h))
    --m3-surface-container-low: oklch(0.20 0.014 var(--m3-h))
    --m3-surface-container: oklch(0.22 0.016 var(--m3-h))
    --m3-surface-container-high: oklch(0.25 0.018 var(--m3-h))
    --m3-surface-container-highest: oklch(0.29 0.02 var(--m3-h))
    --m3-on-surface: oklch(0.92 0.01 var(--m3-h))
    --m3-on-surface-variant: oklch(0.80 0.02 var(--m3-h))
    --m3-outline: oklch(0.62 0.02 var(--m3-h))
    --m3-outline-variant: oklch(0.36 0.02 var(--m3-h))
    --m3-inverse-surface: oklch(0.92 0.01 var(--m3-h))
    --m3-inverse-on-surface: oklch(0.25 0.02 var(--m3-h))
    --m3-shadow: unquote('oklch(0 0 0 / 0.5)')
    --m3-scrim: unquote('oklch(0 0 0 / 0.6)')
    color-scheme: dark

@media (prefers-color-scheme: dark)
    html[data-appearance="auto"]
        m3e-dark-tokens()

html[data-appearance="dark"]
    m3e-dark-tokens()

// 2. Base

html
    background-color: var(--m3-surface)
    font-size: 15px
    font-optical-sizing: auto
    scrollbar-color: var(--m3-outline-variant) transparent

html body
    background-color: var(--m3-surface)
    color: var(--m3-on-surface)

html body, html button, html input, html select, html textarea
    font-family: var(--m3-font)

html ::selection
    background: var(--m3-primary-container)
    color: var(--m3-on-primary-container)

html a, html a:hover
    color: var(--m3-primary)

html .link-muted
    color: inherit

// The base helper declares its hover color !important.

html .link-muted:hover
    color: var(--m3-primary) !important

html :focus-visible
    outline: 3px solid var(--m3-primary)
    outline-offset: 2px

html .has-text-grey, html .has-text-grey-light
    color: var(--m3-on-surface-variant) !important

html hr
    background-color: var(--m3-outline-variant)
    height: 1px

html .pace .pace-progress
    background: var(--m3-primary)
