    --m3-scrim: unquote('oklch(0.15 0.02 var(--m3-h) / 0.45)')
    --m3-font: "Roboto Flex", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif
    --m3-font-mono: "Roboto Mono", "Source Code Pro", Consolas, "Noto Sans SC", "PingFang SC", "Microsoft YaHei", ui-monospace, monospace
