        --m3-surface: oklch(0.16 0.012 var(--m3-h))
        --m3-surface-container-lowest: oklch(0.13 0.01 var(--m3-h))
        --m3-surface-container-low: oklch(0.20 0.014 var(--m3-h))
        --m3-surface-container: oklch(0.22 0.016 var(--m3-h))
        --m3-surface-container-high: oklch(0.25 0.018 var(--m3-h))
        --m3-surface-container-highest: oklch(0.29 0.02 var(--m3-h))
        --m3-on-surface: oklch(0.92 0.01 var(--m3-h))
        --m3-on-surface-variant: oklch(0.80 0.02 var(--m3-h))
        --m3-outline: oklch(0.62 0.02 var(--m3-h))
        --m3-outline-variant: oklch(0.36 0.02 var(--m3-h))
        --m3-inverse-surface: oklch(0.92 0.01 var(--m3-h))
        --m3-inverse-on-surface: oklch(0.25 0.02 var(--m3-h))
        --m3-shadow: unquote('oklch(0 0 0 / 0.5)')
        --m3-scrim: unquote('oklch(0 0 0 / 0.6)')
        color-scheme: dark

html[data-appearance="dark"]
    --m3-primary: oklch(0.80 0.11 var(--m3-h))
    --m3-on-primary: oklch(0.28 0.11 var(--m3-h))
    --m3-primary-container: oklch(0.38 0.13 var(--m3-h))
    --m3-on-primary-container: oklch(0.92 0.06 var(--m3-h))
    --m3-secondary: oklch(0.80 0.05 var(--m3-h))
    --m3-on-secondary: oklch(0.28 0.04 var(--m3-h))
    --m3-secondary-container: oklch(0.36 0.05 var(--m3-h))
    --m3-on-secondary-container: oklch(0.91 0.03 var(--m3-h))
    --m3-tertiary: oklch(0.82 0.10 calc(var(--m3-h) + 75))
    --m3-on-tertiary: oklch(0.28 0.09 calc(var(--m3-h) + 75))
    --m3-tertiary-container: oklch(0.40 0.10 calc(var(--m3-h) + 75))
    --m3-on-tertiary-container: oklch(0.92 0.06 calc(var(--m3-h) + 75))
    --m3-warning-container: oklch(0.40 0.08 80)
    --m3-on-warning-container: oklch(0.92 0.07 85)
    --m3-error-container: oklch(0.40 0.11 25)
    --m3-on-error-container: oklch(0.92 0.05 25)
    --m3-surface: oklch(0.16 0.012 var(--m3-h))
    --m3-surface-container-lowest: oklch(0.13 0.01 var(--m3-h))
    --m3-surface-container-low: oklch(0.20 0.014 var(--m3-h))
    --m3-surface-container: oklch(0.22 0.016 var(--m3-h))
    --m3-surface-container-high: oklch(0.25 0.018 var(--m3-h))
    --m3-surface-container-highest: oklch(0.29 0.02 var(--m3-h))
    --m3-on-surface: oklch(0.92 0.01 var(--m3-h))
    --m3-on-surface-variant: oklch(0.80 0.02 var(--m3-h))
    --m3-outline: oklch(0.62 0.02 var(--m3-h))
    --m3-outline-variant: oklch(0.36 0.02 var(--m3-h))
    --m3-inverse-surface: oklch(0.92 0.01 var(--m3-h))
    --m3-inverse-on-surface: oklch(0.25 0.02 var(--m3-h))
    --m3-shadow: unquote('oklch(0 0 0 / 0.5)')
    --m3-scrim: unquote('oklch(0 0 0 / 0.6)')
    color-scheme: dark

// 2. Base

html
    background-color: var(--m3-surface)
    font-size: 15px
    font-optical-sizing: auto
    scrollbar-color: var(--m3-outline-variant) transparent

html body
    background-color: var(--m3-surface)
    color: var(--m3-on-surface)

html body, html button, html input, html select, html textarea
    font-family: var(--m3-font)

html ::selection
    background: var(--m3-primary-container)
    color: var(--m3-on-primary-container)

html a, html a:hover
    color: var(--m3-primary)

html .link-muted
    color: inherit

// The base helper declares its hover color !important.

html .link-muted:hover
    color: var(--m3-primary) !important

html :focus-visible
    outline: 3px solid var(--m3-primary)
    outline-offset: 2px

html .has-text-grey, html .has-text-grey-light
    color: var(--m3-on-surface-variant) !important

html hr
    background-color: var(--m3-outline-variant)
    height: 1px

html .pace .pace-progress
    background: var(--m3-primary)

@keyframes m3-spin
    to
        transform: rotate(360deg)

// 3. Navigation

html .navbar-main
    background-color: var(--m3-surface)
    box-shadow: none

html .navbar-main .navbar-container, html .navbar-main .navbar-menu, html .navbar-main .navbar-brand
    background-color: transparent
    box-shadow: none

html .navbar-main[data-sticky]
    background-color: unquote('color-mix(in oklab, var(--m3-surface) 88%, transparent)')
    -webkit-backdrop-filter: unquote('saturate(1.4) blur(14px)')
    backdrop-filter: unquote('saturate(1.4) blur(14px)')

html .navbar-main .navbar-start .navbar-item, html .navbar-main .navbar-item.has-dropdown .navbar-link
    margin: .7rem 2px
    padding: .55rem 1.05rem
    border-radius: var(--m3-r-m)
    color: var(--m3-on-surface-variant)
    font-weight: 500
    letter-spacing: .01em
    transition: var(--m3-state-transition)

html .navbar-main .navbar-start .navbar-item.has-dropdown
    margin: 0
    padding: 0
    background: none

html .navbar-main .navbar-start a.navbar-item:hover, html .navbar-main .navbar-start a.navbar-item:focus, html .navbar-main .navbar-item.has-dropdown .navbar-link:hover
    background-color: unquote('color-mix(in oklab, var(--m3-on-surface) 8%, transparent)')
    color: var(--m3-on-surface)

html .navbar-main .navbar-start > a.navbar-item.is-active, html .navbar-main .navbar-start > a.navbar-item.is-active:not(:focus):not(:hover), html .navbar-main .navbar-item.has-dropdown .navbar-link.is-active
    background-color: var(--m3-secondary-container)
    color: var(--m3-on-secondary-container)
    font-weight: 700

html .navbar-main .navbar-brand
    margin-left: 0

html .navbar-main .navbar-logo
    padding-left: 1.6rem
    padding-right: 1rem

html .navbar-main .navbar-end .navbar-item, html .navbar-main button.navbar-item
    color: var(--m3-on-surface-variant)
    background: none

html .navbar-main .navbar-end .navbar-item
    width: 44px
    height: 44px
    margin: auto 2px
    padding: 0
    justify-content: center
    border-radius: var(--m3-r-m)
    transition: var(--m3-state-transition)

html .navbar-main .navbar-end .navbar-item:hover, html .navbar-main button.navbar-item:hover, html .navbar-main button.navbar-item:focus
    background-color: unquote('color-mix(in oklab, var(--m3-on-surface) 8%, transparent)')
    color: var(--m3-on-surface)

html .navbar-main .navbar-toggle
    border-radius: var(--m3-r-m)
    transition: var(--m3-state-transition)

// Bounded radii and a non-overshooting easing keep press/release from snapping through zero.

html .navbar-main .navbar-start > a.navbar-item:is(:hover, :focus-visible)
    border-radius: 24px

html .navbar-main .navbar-link:is(:hover, :focus-visible)
    border-radius: 24px

html .navbar-main .navbar-end .navbar-item:is(:hover, :focus-visible)
    border-radius: 24px

html .navbar-main .navbar-toggle:is(:hover, :focus-visible)
    border-radius: 24px

html .navbar-main .navbar-toggle[aria-expanded="true"]
    background-color: var(--m3-secondary-container)
    color: var(--m3-on-secondary-container)

html .navbar-main.is-collapsed .navbar-dropdown
    background: var(--m3-navbar)
    border-radius: var(--m3-r-l)

html .navbar-main.is-scripted:not(.is-collapsed) .navbar-dropdown
    background-color: var(--m3-navbar)
    border: none
    border-radius: var(--m3-r-l)
    box-shadow: var(--m3-elev-3)
    padding: .5rem
    transform-origin: top left
    animation: m3-menu var(--m3-spring-fast-ms) var(--m3-spring-fast)

@keyframes m3-menu
    from
        opacity: 0
        transform: scale(.88)

html .navbar-main .navbar-dropdown .navbar-item, html .navbar-main.is-scripted:not(.is-collapsed) .navbar-dropdown .navbar-item
    margin: 1px 0
    padding: .6rem 1rem
    border-radius: var(--m3-r-m)
    color: var(--m3-on-surface)
    transition: var(--m3-state-transition)

html .navbar-main.is-scripted:not(.is-collapsed) .navbar-dropdown a.navbar-item:hover
    border-radius: 20px

html .navbar-main.is-scripted:not(.is-collapsed) .navbar-dropdown a.navbar-item:hover
    background-color: var(--m3-surface-container-highest)
    color: var(--m3-on-surface)

html .navbar-main .navbar-dropdown a.navbar-item.is-active, html .navbar-main.is-scripted:not(.is-collapsed) .navbar-dropdown a.navbar-item.is-active
    background-color: var(--m3-secondary-container)
    color: var(--m3-on-secondary-container)
    font-weight: 600

html .navbar-main.is-collapsed .navbar-start .navbar-item
    margin: 2px 0

html .navbar-main.is-collapsed .navbar-start .navbar-link[aria-expanded="true"] + .navbar-dropdown a.navbar-item
    color: var(--m3-on-surface-variant)

// 4. Cards

html .card:where(:not(#back-to-top))
    background-color: var(--m3-surface-container-low)
    color: var(--m3-on-surface)
    border-radius: var(--m3-card-r)
    box-shadow: 0 0 0 1px var(--m3-outline-variant)

// Clip the media, not the whole card: donation QR popovers must be able to escape it.

html .card > .card-image:first-child .image
    border-radius: var(--m3-card-r) var(--m3-card-r) 0 0

html .card + .card, html .card + .post-navigation
    margin-top: 1.25rem

html .card .card-image
    padding: 0

html .card .card-image .image
    border-radius: var(--m3-card-r)
    overflow: hidden
    isolation: isolate

html .card .card-image .image img
    transition: transform var(--m3-spring-slow-ms) var(--m3-spring-slow)

html .card:hover .card-image a.image img
    transform: scale(1.04)

html .card-content
    --m3-cc-x: 1.75rem
    padding: 1.5rem var(--m3-cc-x)

html .card-content.article .article-meta.is-uppercase
    text-transform: none !important

html .card-content.article .article-meta
    color: var(--m3-on-surface-variant)
    gap: .4rem 0

html .card-content.article .article-meta .level-item
    margin-right: 1rem
    font-variant-numeric: tabular-nums

html .card-content.article .article-meta a.link-muted
    display: inline-flex
    align-items: center
    height: 26px
    padding: 0 10px
    border-radius: var(--m3-r-s)
    background: var(--m3-secondary-container)
    color: var(--m3-on-secondary-container)
    font-weight: 600
    transition: var(--m3-state-transition)

html .card-content.article .article-meta a.link-muted + a.link-muted
    margin-left: 4px

html .card-content.article .article-meta a.link-muted:hover
    border-radius: 13px
    background: var(--m3-secondary)
    color: var(--m3-on-secondary) !important

html .card-content.article .title.is-3
    font-family: var(--m3-font)
    font-weight: 700
    line-height: 1.28
    letter-spacing: -.005em
    font-variation-settings: "wdth" 108, "opsz" 144
    color: var(--m3-on-surface)
    text-wrap: balance

html .card-content.article h1.title.is-3
    font-size: 2.3rem

html .card-content.article .title.is-3 a:hover
    color: var(--m3-primary)

html article.article .article-more
    height: 40px
    padding: 0 1.25rem
    border: none
    border-radius: var(--m3-r-m)
    background-color: var(--m3-secondary-container)
    color: var(--m3-on-secondary-container)
    font-weight: 600
    transition: var(--m3-state-transition)

html article.article .article-more:hover
    border-radius: 24px
    background-color: var(--m3-primary)
    color: var(--m3-on-primary)

html article.article .article-more::after
    content: "\f054"
    margin-left: .65em
    font-family: "Font Awesome 6 Free", "Font Awesome 5 Free"
    font-weight: 900
    font-size: .75em

// 5. Typography

html .content
    color: var(--m3-on-surface)
    font-size: 1.0625rem
    line-height: 1.85

html .content p:not(:last-child), html .content ul:not(:last-child), html .content ol:not(:last-child)
    margin-bottom: 1.15em

html .content h1, html .content h2, html .content h3, html .content h4, html .content h5, html .content h6
    color: var(--m3-on-surface)
    font-family: var(--m3-font)
    font-weight: 700
    line-height: 1.35
    text-wrap: balance

html .content h2
    font-size: 1.55em
    margin-top: 1.8em

html .content h3
    font-size: 1.25em
    margin-top: 1.5em

html .content a:not(:where(.headerlink, .tag, .button, .gallery-item, .gallery-item a, .tags, .justified-gallery > a))
    color: var(--m3-primary)
    text-decoration: underline
    text-decoration-color: unquote('color-mix(in oklab, var(--m3-primary) 40%, transparent)')
    text-underline-offset: 3px

html .content a:not(:where(.headerlink, .tag, .button, .gallery-item, .gallery-item a, .tags, .justified-gallery > a)):hover
    text-decoration-color: currentColor

html .content .headerlink
    color: var(--m3-outline)

html .content strong
    color: inherit

html .content ul li::marker, html .content ol li::marker
    color: var(--m3-primary)

html .content blockquote
    position: relative
    isolation: isolate
    background: var(--m3-tertiary-container)
    color: var(--m3-on-tertiary-container)
    border: none
    border-radius: var(--m3-r-xl) var(--m3-r-xl) var(--m3-r-xl) var(--m3-r-s)
    padding: 1.35em 1.5em 1.35em 3.5em
    font-weight: 500

html .content blockquote::before
    content: "\201C"
    position: absolute
    inset-inline-start: .3em
    top: .12em
    font: 850 3em/1 var(--m3-font)
    color: var(--m3-tertiary)

html .content blockquote > :last-child
    margin-bottom: 0

html .content blockquote footer
    margin-top: .75em
    font-size: .85em
    color: var(--m3-on-surface-variant)

html .content :not(pre) > code, html .content p code, html .content li code
    background-color: var(--m3-surface-container-high)
    color: var(--m3-on-surface)
    border-radius: 6px
    padding: .12em .4em
    font-family: var(--m3-font-mono)
    font-size: .88em

html .content img
    border-radius: var(--m3-r-l)

html .content .justified-gallery > a
    border-radius: var(--m3-r-l)
    overflow: hidden
    text-decoration: none

html .content .justified-gallery > a > .caption
    border-radius: 0 0 var(--m3-r-l) var(--m3-r-l)
    text-decoration: none

html .content .gallery-item, html .content .gallery-item a
    text-decoration: none

html .content .gallery-item .caption
    color: var(--m3-on-surface-variant)
    text-decoration: none

html .content table td, html .content table th
    border-color: var(--m3-outline-variant)

html .content table th, html .content table thead td, html .content table thead th
    color: var(--m3-on-surface-variant)

html .content figure.highlight, html .content pre, html .content .highlight pre, html .content .hljs
    background-color: var(--m3-surface-container-highest)
    color: var(--m3-on-surface)

html .content figure.highlight
    border-radius: var(--m3-r-l)
    overflow: hidden
    box-shadow: none

html .content figure.highlight figcaption
    background-color: var(--m3-surface-container-high)
    color: var(--m3-on-surface-variant)
    padding: .5em 1em
    font-family: var(--m3-font)

html .content figure.highlight figcaption .copy, html .content figure.highlight figcaption .fold
    color: var(--m3-on-surface-variant)
    border-radius: var(--m3-r-s)
    transition: var(--m3-state-transition)

html .content figure.highlight figcaption :is(.copy, .fold):is(:hover, :focus-visible)
    border-radius: var(--m3-r-l)
    background: var(--m3-surface-container-highest)

html .content figure.highlight pre, html .content figure.highlight code
    font-family: var(--m3-font-mono)

html .content figure.highlight .gutter pre
    color: var(--m3-outline)
    background: transparent

html .content figure.highlight .code pre
    background: transparent

html .content figure.highlight table, html .content figure.highlight td
    border: none
    background: transparent

html .message
    background: none
    border-radius: var(--m3-r-l-plus)

html .message .message-body
    border: none
    border-radius: var(--m3-r-l-plus)
    background-color: var(--m3-secondary-container)
    color: var(--m3-on-secondary-container)

html .message.is-primary .message-body, html .message.is-link .message-body
    background-color: var(--m3-primary-container)
    color: var(--m3-on-primary-container)

html .message.is-warning .message-body
    background-color: var(--m3-warning-container)
    color: var(--m3-on-warning-container)

html .message.is-danger .message-body
    background-color: var(--m3-error-container)
    color: var(--m3-on-error-container)

html .message.is-success .message-body, html .message.is-info .message-body
    background-color: var(--m3-tertiary-container)
    color: var(--m3-on-tertiary-container)

// Override Bulma's more specific message link color.

html .message a:not(.button):not(.tag):not(.dropdown-item)
    color: var(--m3-primary)
    text-decoration: underline
    text-decoration-color: unquote('color-mix(in oklab, var(--m3-primary) 40%, transparent)')
    text-underline-offset: 3px

html .message a:not(.button):not(.tag):not(.dropdown-item):hover
    text-decoration-color: currentColor

html .content .tabs.is-boxed a
    border-radius: var(--m3-r-m) var(--m3-r-m) 0 0
    color: var(--m3-on-surface-variant)

html .content .tabs.is-boxed li.is-active a
    background-color: var(--m3-surface-container-high)
    color: var(--m3-primary)
    border-color: var(--m3-outline-variant)

html .content .tabs ul
    border-bottom-color: var(--m3-outline-variant)

// 6. Buttons, tags and connected pagination

html .button, html .button.is-rounded
    border-radius: var(--m3-r-m)
    font-weight: 500
    transition: var(--m3-state-transition)

html .button:is(:hover, :focus-visible)
    border-radius: 24px

html .button.is-primary
    background-color: var(--m3-primary)
    color: var(--m3-on-primary)
    border: none

html .button.is-primary:hover, html .button.is-primary:focus
    background-color: unquote('color-mix(in oklab, var(--m3-primary) 88%, var(--m3-on-primary))')
    color: var(--m3-on-primary)

html .button.is-transparent
    background: transparent
    border: none
    color: var(--m3-on-surface-variant)

html .button.is-transparent:hover
    background-color: unquote('color-mix(in oklab, var(--m3-on-surface) 8%, transparent)')
    color: var(--m3-on-surface)

html .button.is-white, html .button.is-light
    background-color: var(--m3-surface-container-high)
    color: var(--m3-on-surface)
    border: none

html .tag:not(body)
    background-color: var(--m3-surface-container)
    color: var(--m3-on-surface)
    border-radius: var(--m3-r-full)
    font-variant-numeric: tabular-nums

// Semantic tag colors apply to custom tag links as well as plain spans.

html .tag:not(body).is-primary, html .tag:not(body).is-link
    background: var(--m3-primary-container)
    color: var(--m3-on-primary-container)

html .tag:not(body).is-info
    background: var(--m3-info-container)
    color: var(--m3-on-info-container)

html .tag:not(body).is-success
    background: var(--m3-success-container)
    color: var(--m3-on-success-container)

html .tag:not(body).is-warning
    background: var(--m3-warning-container)
    color: var(--m3-on-warning-container)

html .tag:not(body).is-danger
    background: var(--m3-error-container)
    color: var(--m3-on-error-container)

html .tag:not(body).is-dark
    background: var(--m3-inverse-surface)
    color: var(--m3-inverse-on-surface)

html .content a.tag
    border-radius: var(--m3-r-s)
    text-decoration: none
    transition: var(--m3-state-transition)

html .content a.tag:hover
    border-radius: 15px
    filter: brightness(.96)

html .pagination
    gap: 12px
    align-items: center
    margin: 1.5rem 0 0

html .pagination .pagination-previous, html .pagination .pagination-next
    height: 40px
    min-width: 0
    margin: 0
    padding: 0
    border: none
    box-shadow: none
    border-radius: var(--m3-r-m)
    background-color: var(--m3-secondary-container)
    color: var(--m3-on-secondary-container)
    font-weight: 600
    transition: var(--m3-state-transition)

html .pagination .pagination-previous a, html .pagination .pagination-next a
    display: inline-flex
    align-items: center
    gap: .55em
    height: 100%
    padding: 0 1.2em
    color: inherit
    border-radius: inherit

html .pagination .pagination-previous a::before, html .pagination .pagination-next a::after
    font-family: "Font Awesome 6 Free", "Font Awesome 5 Free"
    font-weight: 900
    font-size: .75em

html .pagination .pagination-previous a::before
    content: "\f053"

html .pagination .pagination-next a::after
    content: "\f054"

html .pagination .pagination-previous:hover, html .pagination .pagination-next:hover
    border-radius: 20px
    background-color: unquote('color-mix(in oklab, var(--m3-secondary-container) 88%, var(--m3-on-secondary-container))')

html .pagination .pagination-list
    gap: 2px
    flex-wrap: nowrap

html .pagination .pagination-list li
    margin: 0

html .pagination .pagination-link, html .pagination .pagination-ellipsis
    margin: 0
    height: 40px
    min-width: 44px
    padding: 0 .8em
    border: none
    box-shadow: none
    border-radius: var(--m3-r-s)
    background-color: var(--m3-secondary-container)
    color: var(--m3-on-secondary-container)
    font-weight: 600
    font-variant-numeric: tabular-nums
    transition: var(--m3-state-transition)

html .pagination .pagination-ellipsis
    background: transparent
    color: var(--m3-on-surface-variant)
    pointer-events: none

// Half-height caps avoid CSS scaling down the inner corners with a 999px outer radius.

html .pagination .pagination-list li:first-child > *
    border-radius: 20px var(--m3-r-s) var(--m3-r-s) 20px

html .pagination .pagination-list li:last-child > *
    border-radius: var(--m3-r-s) 20px 20px var(--m3-r-s)

html .pagination .pagination-list li:only-child > *
    border-radius: 20px

html .pagination .pagination-list li > .pagination-link:hover
    border-radius: var(--m3-r-l)
    background-color: unquote('color-mix(in oklab, var(--m3-secondary-container) 88%, var(--m3-on-secondary-container))')

html .pagination .pagination-list li:first-child > .pagination-link:hover
    border-radius: 20px var(--m3-r-l) var(--m3-r-l) 20px

html .pagination .pagination-list li:last-child > .pagination-link:hover
    border-radius: var(--m3-r-l) 20px 20px var(--m3-r-l)

html .pagination .pagination-list li > .pagination-link.is-current, html .pagination .pagination-list li > .pagination-link.is-current:hover
    background-color: var(--m3-primary)
    color: var(--m3-on-primary)
    border-radius: 20px

// 7. Widgets

html .card.widget .card-content
    padding: 1.25rem

html .widget .menu-label
    --w-icon: "\f111"
    --w-shape: var(--m3-shape-cookie9)
    position: relative
    display: flex
    align-items: center
    min-height: 34px
    padding-left: 46px
    margin-bottom: .85rem
    font-family: var(--m3-font)
    font-size: 1rem
    font-weight: 750
    letter-spacing: 0
    text-transform: none
    color: var(--m3-on-surface)

html .widget .menu-label::before
    content: ""
    position: absolute
    left: 0
    top: 0
    width: 34px
    height: 34px
    background: var(--m3-secondary-container)
    -webkit-mask: var(--w-shape) center / contain no-repeat
    mask: var(--w-shape) center / contain no-repeat
    transition: transform var(--m3-spring-slow-ms) var(--m3-spring-slow)

html .widget .menu-label::after
    content: var(--w-icon)
    position: absolute
    left: 0
    top: 0
    width: 34px
    line-height: 34px
    text-align: center
    font-family: "Font Awesome 6 Free", "Font Awesome 5 Free"
    font-weight: 900
    font-size: 13px
    color: var(--m3-on-secondary-container)

html .widget:hover .menu-label::before
    transform: rotate(60deg)

html .widget[data-type="links"] .menu-label
    --w-icon: "\f0c1"
    --w-shape: var(--m3-shape-cookie4)

html .widget[data-type="categories"] .menu-label
    --w-icon: "\f07b"
    --w-shape: var(--m3-shape-clover4)

html .widget[data-type="recent-posts"] .menu-label
    --w-icon: "\f1da"
    --w-shape: var(--m3-shape-cookie6)

html .widget[data-type="archives"] .menu-label
    --w-icon: "\f187"
    --w-shape: var(--m3-shape-pentagon)

html .widget[data-type="tags"] .menu-label
    --w-icon: "\f02b"
    --w-shape: var(--m3-shape-burst)

html .widget[data-type="toc"] .menu-label
    --w-icon: "\f03a"
    --w-shape: var(--m3-shape-sunny)

html .widget[data-type="subscribe-email"] .menu-label
    --w-icon: "\f0e0"
    --w-shape: var(--m3-shape-flower)

html .widget .menu-list a
    border-radius: 4px
    padding: .7em .9em
    color: var(--m3-on-surface)
    transition: var(--m3-state-transition)

html .widget .menu-list a:hover
    background-color: var(--m3-secondary-container)
    color: var(--m3-on-secondary-container)

html .widget .menu-list a.is-active
    background-color: var(--m3-secondary-container)
    color: var(--m3-on-secondary-container)
    font-weight: 600

html .widget .menu-list li ul
    border-inline-start: 2px solid var(--m3-outline-variant)
    margin: 2px 0 2px .75rem
    padding-inline-start: .5rem

html .widget .menu-list li + li
    margin-top: 2px

html .widget .menu-list .level-item.tag
    height: 22px
    min-width: 28px
    padding: 0 .55em
    font-size: .75rem
    font-weight: 600

html .widget .menu-list a:hover .level-item.tag
    background-color: var(--m3-surface-container-highest)

html .widget .menu-list a.is-active .level-item.tag
    background-color: var(--m3-on-secondary-container)
    color: var(--m3-secondary-container)

html .widget[data-type="profile"]
    background-color: var(--m3-primary-container)
    color: var(--m3-on-primary-container)
    box-shadow: none

html .widget[data-type="profile"] .title.is-size-4
    color: var(--m3-on-primary-container)
    font-family: var(--m3-font)
    font-weight: 700

html .widget[data-type="profile"] p.is-size-6
    color: var(--m3-on-primary-container)
    opacity: .88

html .widget[data-type="profile"] nav.level.is-mobile
    gap: 2px

html .widget[data-type="profile"] nav.level.is-mobile > .level-item
    position: relative
    padding: .65rem .25rem
    background: unquote('color-mix(in oklab, var(--m3-on-primary-container) 9%, transparent)')
    border-radius: var(--m3-r-s)
    transition: var(--m3-state-transition)

html .widget[data-type="profile"] nav.level.is-mobile > .level-item:first-child
    border-radius: var(--m3-r-l) var(--m3-r-s) var(--m3-r-s) var(--m3-r-l)

html .widget[data-type="profile"] nav.level.is-mobile > .level-item:last-child
    border-radius: var(--m3-r-s) var(--m3-r-l) var(--m3-r-l) var(--m3-r-s)

html .widget[data-type="profile"] nav.level.is-mobile > .level-item:is(:hover, :focus-within)
    border-radius: 24px
    background: unquote('color-mix(in oklab, var(--m3-on-primary-container) 15%, transparent)')

// Make the whole statistic tile a link without changing its markup or its accessible name.

html .widget[data-type="profile"] nav.level.is-mobile > .level-item a::after
    content: ""
    position: absolute
    inset: 0
    border-radius: inherit

html .widget[data-type="profile"] nav.level.is-mobile > .level-item:has(a:focus-visible)
    outline: 2px solid var(--m3-primary)
    outline-offset: 2px

html .widget[data-type="profile"] nav.level.is-mobile a:focus-visible
    outline: none

html .widget[data-type="profile"] .heading
    color: var(--m3-on-primary-container)
    opacity: .8
    letter-spacing: .04em

html .widget[data-type="profile"] .level-item .title
    color: var(--m3-on-primary-container)
    font-family: var(--m3-font)
    font-weight: 800
    font-variant-numeric: tabular-nums

html .widget[data-type="profile"] .level-item a
    color: inherit

html .widget[data-type="profile"] .button.is-primary
    width: 100%
    height: 48px
    border-radius: var(--m3-r-m)
    font-weight: 600

html .widget[data-type="profile"] .button.is-primary:is(:hover, :focus-visible)
    border-radius: 24px

html .widget[data-type="profile"] .button.is-transparent
    color: var(--m3-on-primary-container)
    width: 40px
    height: 40px
    border-radius: var(--m3-r-m)

html .widget[data-type="profile"] .button.is-transparent:is(:hover, :focus-visible)
    border-radius: 20px
    background-color: unquote('color-mix(in oklab, var(--m3-on-primary-container) 10%, transparent)')

html .widget article.media
    margin: 0 -.5rem
    padding: .5rem
    border: none
    background: transparent

html .widget article.media + article.media
    margin-top: 2px
    padding-top: .5rem
    border: none

html .widget article.media:last-child
    margin-bottom: -.5rem

html .widget article.media .media-left .image
    border-radius: var(--m3-r-m)
    overflow: hidden

html .widget article.media .date
    color: var(--m3-on-surface-variant)
    font-family: var(--m3-font-mono)

html .widget article.media .title a
    color: var(--m3-on-surface)
    font-weight: 600
    line-height: 1.45

html .widget article.media .title a:hover
    color: var(--m3-primary)

html .widget article.media .categories
    text-transform: none !important

html .widget article.media .categories a
    color: var(--m3-primary)

html .widget .tags.has-addons
    margin: 0
    border-radius: var(--m3-r-s)
    box-shadow: none
    overflow: hidden
    transition: var(--m3-state-transition)

html .widget .tags.has-addons .tag
    margin: 0
    height: 30px
    border-radius: 0
    background: transparent
    color: var(--m3-on-surface-variant)
    font-size: .8125rem
    font-weight: 500

html .widget .tags.has-addons .tag:first-child:not(:only-child)
    padding-right: .35em

html .widget .tags.has-addons .tag:last-child:not(:only-child)
    padding-left: .35em
    opacity: .7
    font-variant-numeric: tabular-nums

html .widget .tags.has-addons:hover
    background-color: var(--m3-secondary-container)

html .widget .tags.has-addons:hover .tag
