    width: 2.5em
    color: var(--m3-on-tertiary-container)

html .widget[data-type="subscribe-email"] .input::placeholder
    color: var(--m3-on-tertiary-container)
    opacity: .7

html .widget[data-type="subscribe-email"] .field.has-addons .control .button
    width: 100%
    max-width: 100%
    height: 48px
    border-radius: var(--m3-r-m)
    background-color: var(--m3-tertiary)
    color: var(--m3-on-tertiary)
    border: none

html .widget[data-type="subscribe-email"] .field.has-addons .control .button:hover
