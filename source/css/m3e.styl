html .widget[data-type="subscribe-email"] .field.has-addons
    display: grid
    grid-template-columns: minmax(0, 1fr) auto
    gap: 8px

html .widget[data-type="subscribe-email"] .field.has-addons > .control
    margin: 0
    min-width: 0

html .widget[data-type="subscribe-email"] .field.has-addons .control .input
    width: 100%
    min-width: 0
    height: 48px
    border: 2px solid var(--m3-on-tertiary-container)
    border-radius: var(--m3-r-m)
