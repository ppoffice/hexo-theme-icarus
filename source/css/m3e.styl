    --m3-surface-container: oklch(0.95 0.015 var(--m3-h))
    --m3-surface-container-high: oklch(0.93 0.017 var(--m3-h))
    --m3-surface-container-highest: oklch(0.91 0.02 var(--m3-h))
    --m3-on-surface: oklch(0.22 0.02 var(--m3-h))
    --m3-on-surface-variant: oklch(0.42 0.025 var(--m3-h))
