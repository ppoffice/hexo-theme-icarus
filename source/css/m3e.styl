html .timeline .media::before
    background: var(--m3-primary) !important
    border: none !important
    border-radius: 0 !important
    width: 14px !important
    height: 14px !important
    -webkit-mask: var(--m3-shape-cookie6) center / contain no-repeat
    mask: var(--m3-shape-cookie6) center / contain no-repeat
    transition: transform var(--m3-spring-fast-ms) var(--m3-spring-fast)

html .timeline .media:hover::before
