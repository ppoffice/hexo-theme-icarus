html .widget[data-type="subscribe-email"] .menu-label::before
    background: var(--m3-tertiary)

html .widget[data-type="subscribe-email"] .menu-label::after
    color: var(--m3-on-tertiary)

html .widget[data-type="subscribe-email"] form
